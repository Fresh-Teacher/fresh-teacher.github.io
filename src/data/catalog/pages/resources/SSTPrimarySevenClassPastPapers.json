  "styles": "\n body {\n  background-color: #f6f6f6;\n}\n\n  /* Styling for the floating WhatsApp button */\n  .floating-whatsapp {\n      position: fixed;\n      bottom: 20px;\n      right: 20px;\n      z-index: 999;\n      padding: 10px;\n    }\n\n.search-bar {\n      margin-bottom: 20px;\n    }\n\n    .search-input {\n      width: 300px;\n      padding: 6px;\n    }\n\n.fa-file {\n  display: none;\n}\n\n/* Navbar */\n.navbar-brand {\n  text-decoration: none;\n}\n\n    .navbar-brand-content {\n      display: flex;\n      align-items: center;\n    }\n\n    .navbar-brand-text {\n      display: flex;\n      flex-direction: column;\n      align-items: flex-start;\n      margin-left: 10px;\n    }\n\n    .navbar-brand-title {\n      font-weight: bold;\n      text-decoration: none;\n      animation: blink 3s infinite;\n    }\n\n    .navbar-brand-motto {\n      font-size: 12px;\n      color: #888;\n      margin-top: 5px;\n    }\n\n    .navbar {\n      position: sticky;\n      top: 0;\n      left: 0;\n      right: 0;\n      z-index: 100;\n      background-color: #fff;\n      padding: 10px 20px;\n      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);\n    }\n\n    /* Adjust the height and padding of the navbar */\n    .navbar {\n      height: 80px;\n      padding: 10px 20px;\n    }\n\n.free-price {\n      color: red;\n      text-decoration: line-through;\n    }\n    .free-text {\n      color: green;\n    }\n    .logo-container {\n  display: flex;\n  flex-direction: row;\n  align-items: center;\n}\n\n.price {\n      color: red;\n      text-decoration: line-through;\n    }\n\n\n.logo {\n  display: flex;\n  align-items: center;\n}\n\n.row {\n  padding-top: 30px; /* Adjust the value as needed */\n}\n\n.logo-image {\n  height: 40px;\n  width: auto;\n  margin-right: 5px;\n}\n\n.title {\n  font-weight: bold;\n  font-size: 18px;\n  margin-right: 10px;\n}\n\n.motto {\n  font-size: 14px;\n  font-style: italic;\n}\n\n.logo-image {\n  height: 40px;\n  width: auto;\n  margin-right: 10px; /* Adjust the margin as needed */\n}\n\n.title {\n  font-weight: bold;\n  font-size: 18px;\n}\n\n.motto {\n  font-size: 14px;\n  font-style: italic;\n}\n\n/* PDF Information Section */\n.info {\n  margin-top: 100px;\n}\n\n.card {\n  border: none;\n  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);\n}\n\n.card-body {\n  text-transform: capitalize;\n  padding: 20px;\n}\n\nh3 {\n  text-transform: capitalize;\n  font-size: 18px;\n  font-weight: bold;\n}\n\n.button {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: center;\n}\n\n/* Pagination */\n.pagination-container {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  margin-top: 20px;\n}\n\n.pagination-button {\n  display: inline-block;\n  padding: 8px 16px;\n  border: 1px solid #ccc;\n  background-color: rgb(0, 47, 255);\n  cursor: pointer;\n}\n\n.pagination-button:hover {\n  background-color: #00e5ff;\n}\n\n.pagination-text {\n  margin: 0 10px;\n}\n\n/* Styling for the footer */\n.footer {\n    background-color: #ffffff;\n        color: #000000;\n\n      padding: 0.5rem 0; /* Decreased padding for the top and bottom */\n      text-align: center;\n      margin-top: 2rem; /* Added margin between footer and pagination buttons */\n    }\n\n    .footer a {\n      color: inherit;\n      text-decoration: none;\n    }\n\n    .footer a:hover {\n      text-decoration: underline;\n    }\n\n    @keyframes blink {\n      0% {\n        opacity: 1;\n      }\n      50% {\n        opacity: 0;\n      }\n      100% {\n        opacity: 1;\n      }\n    }\n\n\n  ",
