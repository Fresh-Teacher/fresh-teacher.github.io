"\n    body {\n      font-family: Arial, sans-serif;\n      line-height: 1.5;\n      margin: 20px;\n      font-size: 16px;\n    }\n\n    h1 {\n      font-size: 24px;\n      margin-bottom: 10px;\n      color: black;\n    }\n\n    h2 {\n      font-size: 20px;\n      margin-bottom: 10px;\n    }\n\n    p {\n      margin-bottom: 10px;\n    }\n\n    strong {\n      font-weight: bold;\n    }\n\n    ul {\n      margin: 0;\n      padding: 0;\n      list-style-type: none;\n      margin-bottom: 10px;\n    }\n\n    li {\n      margin-bottom: 5px;\n    }\n\n    .navbar-brand {\n  text-decoration: none;\n}\n\na,\n    button {\n      margin-bottom: 10px;\n    }\n\n    .navbar-brand-content {\n      display: flex;\n      align-items: center;\n    }\n\n    .navbar-brand-text {\n      display: flex;\n      flex-direction: column;\n      align-items: flex-start;\n      margin-left: 10px;\n    }\n\n    .navbar-brand-title {\n      font-weight: bold;\n      text-decoration: none;\n      animation: blink 3s infinite;\n    }\n\n    .navbar-brand-motto {\n      font-size: 12px;\n      color: #888;\n      margin-top: 5px;\n    }\n\n    .navbar {\n      position: sticky;\n      top: 0;\n      left: 0;\n      right: 0;\n      z-index: 100;\n      background-color: #fff;\n      padding: 10px 20px;\n      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);\n    }\n\n    /* Adjust the height and padding of the navbar */\n    .navbar {\n      height: 80px;\n      padding: 10px 20px;\n    }\n\n    footer {\n      background-color: #f6f6f6;\n      padding: 20px;\n      text-align: center;\n      /* Adjust the height of the footer */\n      height: 100px;\n    }\n\n    .container {\n      display: flex;\n      justify-content: center;\n      align-items: center;\n    }\n\n    @keyframes blink {\n      0% {\n        opacity: 1;\n      }\n      50% {\n        opacity: 0;\n      }\n      100% {\n        opacity: 1;\n      }\n    }\n  "