"\n  body {\n    font-family: Arial, sans-serif;\n    margin: 0;\n    padding: 0;\n    padding-bottom: 60px; /* Adjust according to footer height */\n  }\n\n  .container {\n    max-width: 800px;\n    margin: 0 auto;\n    padding: 20px;\n  }\n\n  h1 {\n    text-align: center;\n  }\n\n  ul {\n    list-style-type: none;\n    padding: 0;\n    margin: 0;\n  }\n\n  li {\n    padding: 10px 0;\n  }\n\n  a {\n    text-decoration: none;\n    color: #333;\n    display: block;\n    padding: 5px;\n    border: 1px solid #ccc;\n    border-radius: 5px;\n    transition: background-color 0.3s ease;\n  }\n\n  a:hover {\n    background-color: #0174f9;\n  }\n\n  /* Navbar styles */\n  .navbar {\n    position: sticky;\n    top: 0;\n    left: 0;\n    right: 0;\n    z-index: 100;\n    background-color: #fff;\n    padding: 10px 20px;\n    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);\n    height: 80px; /* Adjust the height of the navbar */\n  }\n\n  .navbar-brand {\n    text-decoration: none;\n  }\n\n  .navbar-brand-content {\n    display: flex;\n    align-items: center;\n  }\n\n  .navbar-brand-text {\n    display: flex;\n    flex-direction: column;\n    align-items: flex-start;\n    margin-left: 10px;\n  }\n\n  .navbar-brand-title {\n    font-weight: bold;\n    text-decoration: none;\n    animation: blink 3s infinite;\n  }\n\n  .navbar-brand-motto {\n    font-size: 12px;\n    color: #888;\n    margin-top: 5px;\n  }\n\n  /* Footer styles */\n  .footer {\n    background-color: #ffffff;\n    height: 60px;\n    position: fixed;\n    bottom: 0;\n    left: 0;\n    right: 0;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    width: 100%;\n  }\n\n  .footer p {\n    text-align: center;\n    font-size: 12px;\n    color: #888;\n  }\n\n  /* Animation */\n  @keyframes blink {\n    0% { opacity: 1; }\n    50% { opacity: 0; }\n    100% { opacity: 1; }\n  }\n"