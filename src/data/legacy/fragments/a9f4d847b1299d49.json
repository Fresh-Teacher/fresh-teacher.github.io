"\n    body {\n      background-color: #f6f6f6;\n    }\n    .navbar-brand-content {\n      display: flex;\n      align-items: center;\n    }\n    .navbar-brand-text {\n      display: flex;\n      flex-direction: column;\n      align-items: flex-start;\n      margin-left: 10px;\n    }\n    .navbar-brand-title {\n      font-weight: bold;\n    }\n    .navbar-brand-motto {\n      font-size: 12px;\n      color: #888;\n      margin-top: 5px;\n    }\n    /* Footer */\n    .footer {\n      background-color: #f8f9fa;\n      padding: 20px 0;\n      text-align: center;\n      width: 100%;\n      position: fixed;\n      bottom: 0;\n    }\n    .footer-divider {\n      margin: 0 10px;\n    }\n    /* Button Container */\n    .button-container {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      min-height: calc(100vh - 200px); /* Adjust the height based on your content */\n      margin-bottom: 100px; /* Adjust the bottom margin based on your content */\n    }\n    .button-container .btn {\n      margin-bottom: 10px; /* Adjust the spacing between buttons */\n    }\n    .navbar-brand {\n  text-decoration: none;\n}\n\n    .navbar-brand-content {\n      display: flex;\n      align-items: center;\n    }\n\n    .navbar-brand-text {\n      display: flex;\n      flex-direction: column;\n      align-items: flex-start;\n      margin-left: 10px;\n    }\n\n    .navbar-brand-title {\n      font-weight: bold;\n      text-decoration: none;\n      animation: blink 3s infinite;\n    }\n\n    .navbar-brand-motto {\n      font-size: 12px;\n      color: #888;\n      margin-top: 5px;\n    }\n\n    .navbar {\n      position: sticky;\n      top: 0;\n      left: 0;\n      right: 0;\n      z-index: 100;\n      background-color: #fff;\n      padding: 10px 20px;\n      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);\n    }\n\n    /* Adjust the height and padding of the navbar */\n    .navbar {\n      height: 80px;\n      padding: 10px 20px;\n    }\n    .fade-animation {\n  animation: blink 3s infinite;\n}\n\n@keyframes blink {\n  0% {\n    opacity: 1;\n  }\n  50% {\n    opacity: 0;\n  }\n  100% {\n    opacity: 1;\n  }\n}\n\n  "